---
import { site, navLinks } from '../config/site';
import { withBase } from '../lib/paths';
const listenHref = site.publicStationUrl || withBase('screenshots');
const listenLabel = site.publicStationUrl ? 'Listen live' : 'Preview UI';
---
<header class="site-header"><div class="container nav-wrap"><a class="brand" href={withBase()} aria-label="JuggleCast Radio Automation home"><img src={withBase('flowcast-mark.svg')} width="36" height="36" alt="" /><span class="brand-text"><strong>JuggleCast</strong><small>Radio Automation</small></span></a><nav class="desktop-nav" aria-label="Main navigation">{navLinks.map((item) => <a href={item.href}>{item.label}</a>)}</nav><div class="header-actions"><a class="button button-quiet button-small" href={listenHref}>{listenLabel}</a><a class="text-link" href={site.repository}>GitHub</a></div><details class="mobile-menu"><summary aria-label="Open navigation"><span></span><span></span><span></span></summary><nav aria-label="Mobile navigation">{navLinks.map((item) => <a href={item.href}>{item.label}</a>)}<a href={site.repository}>GitHub</a><a class="button" href={listenHref}>{listenLabel}</a></nav></details></div></header>
