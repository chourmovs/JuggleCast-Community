---
import { site } from '../config/site';
import { withBase } from '../lib/paths';
const { title = 'Build your station on infrastructure you control.' } = Astro.props;
---
<section class="cta container"><div><p class="eyebrow">READY TO BROADCAST?</p><h2>{title}</h2><p>Review the Community Preview requirements, then install the current validated JuggleCast Radio Automation release.</p></div><div class="cta-actions"><a class="button" href={withBase('installation')}>Install Community</a><a class="button secondary" href={site.docs}>View documentation</a><a class="text-link" href={site.repository}>GitHub ↗</a></div></section>
