---
import { site } from '../config/site';
import { withBase } from '../lib/paths';
const listenHref = site.publicStationUrl || withBase('screenshots');
---
<section class="hero" aria-labelledby="hero-title"><div class="container hero-grid"><div class="hero-copy"><p class="status-line">Community Preview</p><h1 id="hero-title"><span>JuggleCast Radio Automation</span><em>Self-hosted scheduling and playout without Liquidsoap.</em></h1><p class="lede">Schedule music, shape transitions and broadcast to Icecast through a dedicated Rust playout engine — on infrastructure you control.</p><div class="actions"><a class="button" href={listenHref}>{site.publicStationUrl ? 'Listen live' : 'Preview the station UI'}</a><a class="button secondary" href={withBase('installation')}>Install Community</a></div><a class="text-link" href={site.repository}>View on GitHub <span aria-hidden="true">↗</span></a><p class="trust-line">Linux · Docker Compose · Rust playout · Icecast · No Liquidsoap</p></div><div class="product-window hero-window"><div class="window-bar"><i></i><i></i><i></i><span>JuggleCast Control</span></div><img src={withBase('screenshots/Capture1.png')} width="1900" height="1079" alt="JuggleCast Radio Automation control dashboard with live playout, queue and station health" fetchpriority="high" /></div></div></section>
